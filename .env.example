# ==========================================
# UnBook 2.0 - Data Pipeline Environment
# ==========================================

# Configurações de Ambiente (development | staging | production)
ENVIRONMENT=development
LOG_LEVEL=INFO

DB_HOST=aws-0-sa-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
DB_PASSWORD=sua_senha_segura
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:sua_senha_segura@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# SQLite (Fallback para desenvolvimento local offline)
USE_SQLITE_FALLBACK=True
SQLITE_PATH=data/processed/unbook_dev.db

# Diretórios de Dados
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# Scraping & SIGAA Configs
SIGAA_BASE_URL=https://sigaa.unb.br
SCRAPER_HEADLESS=True
SCRAPER_TIMEOUT=30