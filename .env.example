# ==========================================
# UnBook 2.0 - Data Pipeline Environment
# ==========================================

# Configurações de Ambiente (development | staging | production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Banco de Dados Central (PostgreSQL / Core API)
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=unbook_db
DB_USER=unbook_user
DB_PASSWORD=unbook_password_local

# SQLite (Fallback para desenvolvimento local offline)
USE_SQLITE_FALLBACK=True
SQLITE_PATH=data/processed/unbook_dev.db

# Diretórios de Dados
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# Scraping & SIGAA Configs
SIGAA_BASE_URL=https://sigaa.unb.br
SCRAPER_HEADLESS=True
SCRAPER_TIMEOUT=30